    {
      "id": 12,
      "type": "bargauge",
      "title": "Utilisation of line rate",
      "description": "Current throughput against each link's negotiated speed.",
      "datasource": null,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "datasource": null,
          "editorMode": "code",
          "expr": "(max by (link) (rate(talos_net_link_rx_bytes_total{node=\"$node\"}[$__rate_interval])) * 8) / clamp_min(max by (link) (talos_net_link_speed_bits_per_second{node=\"$node\"}), 1) * 100",
          "format": "time_series",
          "instant": true,
          "legendFormat": "in · {{link}}",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": null,
          "editorMode": "code",
          "expr": "(max by (link) (rate(talos_net_link_tx_bytes_total{node=\"$node\"}[$__rate_interval])) * 8) / clamp_min(max by (link) (talos_net_link_speed_bits_per_second{node=\"$node\"}), 1) * 100",
          "format": "time_series",
          "instant": true,
          "legendFormat": "out · {{link}}",
          "range": false,
          "refId": "B"
        }
      ],
      "options": {

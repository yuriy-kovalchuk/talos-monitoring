  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Links",
      "description": "Admin-up links, links with a carrier, and physical NICs. `kind=\"\"` is what makes a link physical.",
      "datasource": null,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": null,
          "editorMode": "code",
          "expr": "count(max by (link) (talos_net_link_up{node=\"$node\"}) == 1) or vector(0)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "up",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": null,
          "editorMode": "code",
          "expr": "count(max by (link) (talos_net_link_carrier{node=\"$node\"}) == 1) or vector(0)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "with carrier",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": null,
          "editorMode": "code",
          "expr": "count(max by (link) (talos_net_link_info{node=\"$node\", kind=\"\"})) or vector(0)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "physical",
          "range": false,
          "refId": "C"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [

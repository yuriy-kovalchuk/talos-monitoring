        "target": {
          "expr": "max(resets(talos_node_uptime_seconds{node=\"$node\"}[$__rate_interval])) > 0",
          "refId": "Anno"
        },
        "titleFormat": "Reboot",
        "textFormat": "the node came back up"
      }
    ]
